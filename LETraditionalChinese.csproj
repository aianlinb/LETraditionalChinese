<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>LatestMajor</RollForward>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
        <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;deps\**</DefaultItemExcludes>
		<InvariantGlobalization>true</InvariantGlobalization>

		<PublishAot>false</PublishAot>
		<IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
		<DebuggerSupport>false</DebuggerSupport>
		<EventSourceSupport>false</EventSourceSupport>

		<Version>2.1.2</Version>
		<Authors>aianlinb</Authors>
		<Copyright>Copyright © 2024-2026 aianlinb</Copyright>
		<PackageId>LastEpoch.TraditionalChinese</PackageId>
		<RepositoryUrl>https://github.com/aianlinb/LETraditionalChinese</RepositoryUrl>
		<PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="tools\LELocalePatch\LELocalePatch.csproj" />
		<ProjectReference Include="tools\LEFontPatch\LEFontPatch.csproj" />
		<Compile Remove="tools\**\*.cs;deps\**\*.cs" />
        <RdXmlFile Include="LibCpp2IL.RD.xml" />
		<None Update="LETraditionalChinese/**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
